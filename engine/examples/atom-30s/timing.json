{
 "dur": 28.021,
 "lines": [
  {
   "t0": 0.2,
   "t1": 3.5,
   "text": "How far would you zoom into your fingertip to see one atom?"
  },
  {
   "t0": 3.85,
   "t1": 7.839,
   "text": "Ten times closer, and the ridges of your fingerprint become hills."
  },
  {
   "t0": 8.079,
   "t1": 10.756,
   "text": "A thousand times, and you hit your skin cells."
  },
  {
   "t0": 10.996,
   "t1": 14.102,
   "text": "Ten thousand, and one cell's nucleus fills the screen."
  },
  {
   "t0": 14.342,
   "t1": 17.69,
   "text": "A million times, and there's your DNA, coiled and twisting."
  },
  {
   "t0": 17.99,
   "t1": 18.928,
   "text": "But keep going."
  },
  {
   "t0": 19.078,
   "t1": 21.026,
   "text": "At a hundred million times closer,"
  },
  {
   "t0": 21.146,
   "t1": 23.04,
   "text": "you finally reach a single atom."
  },
  {
   "t0": 23.44,
   "t1": 27.321,
   "text": "And your fingertip holds more atoms than there are stars in our galaxy."
  }
 ],
